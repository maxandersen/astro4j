        "jitpack",
        "central"
      ],
      "main": "me.champeau.a4j.jsolex.app.JSolEx",
      "enable-preview": true
    },
    "jsolex-cli": {
      "script-ref": "com.github.maxandersen.astro4j:jsolex-cli:jitpack-SNAPSHOT",
      "runtime-options": [
        "-XX:MaxRAMPercentage=80",
        "-XX:+UseG1GC",
        "-XX:+HeapDumpOnOutOfMemoryError",
        "-XX:+UseCompactObjectHeaders",
        "--enable-native-access=javafx.graphics"
      ],
      "repositories": [
        "jitpack",
        "central"
      ],
      "main": "me.champeau.a4j.jsolex.cli.Main",
      "enable-preview": true
    }
